<?xml version="1.0" encoding="utf-8"?>
<!--
  The machine-level NuGet config on this PC defines no package sources at all,
  so this project carries its own (self-contained, reproducible) feed configuration.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
