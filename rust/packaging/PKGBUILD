# Maintainer: United <united@davdigi.com>
pkgname=united-messenger
pkgver=0.3.0
pkgrel=1
pkgdesc="Native unified messenger: WhatsApp, Telegram and Discord without a webview"
arch=('x86_64' 'aarch64')
url="https://github.com/Zwart04/United"
license=('MIT')
depends=('gcc-libs' 'glibc' 'libxkbcommon' 'wayland' 'libx11' 'libxcursor' 'libxi' 'libxrandr' 'vulkan-icd-loader' 'noto-fonts' 'noto-fonts-emoji' 'ttf-dejavu')
makedepends=('rust' 'cargo' 'clang' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::https://github.com/Zwart04/United/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/United-$pkgver/rust"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --release --locked -p united-app
}

package() {
  cd "$srcdir/United-$pkgver/rust"
  install -Dm755 "$srcdir/target/release/united" "$pkgdir/usr/bin/united"
  install -Dm644 packaging/united.desktop "$pkgdir/usr/share/applications/united.desktop"
  install -Dm644 packaging/united-256.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/united.png"
  install -Dm644 packaging/united-512.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/united.png"
  install -Dm644 ../LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
