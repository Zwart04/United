<Window x:Class="United.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:United.App.Shell"
        Title="United"
        Icon="pack://application:,,,/Assets/united.ico"
        Width="1180" Height="760" MinWidth="520" MinHeight="420"
        WindowStyle="None" AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgSurface}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Title bar ───────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{DynamicResource BgSurface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="5" Background="{DynamicResource Accent}" Margin="0,0,8,0">
                        <TextBlock Text="U" FontWeight="Bold" FontSize="11" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                    </Border>
                    <TextBlock Text="United" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                    <TextBlock x:Name="ActiveServiceText" Text="" Foreground="{DynamicResource TextMuted}"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Border x:Name="TotalBadge" Background="{DynamicResource Badge}" CornerRadius="8"
                            Height="16" MinWidth="16" Padding="5,0" Margin="8,0,0,0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="TotalBadgeText" Foreground="White" FontSize="10"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,-0.5,0,0" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource SupportBadge}" Click="SupportUnited_Click"
                            Margin="0,7,8,7" Padding="10,4" ToolTip="Support United on Tako">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Heart}" Fill="White" Width="12" Height="12"
                                  Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="Support" Foreground="White" FontSize="11.5"
                                       FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                            <Border Background="#2EFFFFFF" CornerRadius="7" Padding="5,1"
                                    Margin="7,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Tako" Foreground="White" FontSize="9"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="Min_Click"
                            ToolTip="Minimize">
                        <Path Data="M0,0.5 H10" Stretch="None"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="Max_Click"
                            ToolTip="Maximize">
                        <Path Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stretch="None"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1" />
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButton}" Click="Close_Click"
                            ToolTip="Close to tray">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stretch="None"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1" />
                    </Button>
                </StackPanel>

                <!-- Indeterminate loading bar: kept in the caption row because a hosted
                     WebView2 always paints above WPF layers inside the content area. -->
                <Border Grid.ColumnSpan="3" Height="2" VerticalAlignment="Bottom"
                        ClipToBounds="True" IsHitTestVisible="False">
                    <Border x:Name="Progress" Height="2" Width="140" HorizontalAlignment="Left"
                            Background="{DynamicResource Accent}" Visibility="Collapsed"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform X="-160" />
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <!-- ── Body ────────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource BgSurface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource IconButton}"
                            Click="Settings_Click" ToolTip="Settings  (Ctrl+,)">
                        <Path Data="{StaticResource Icon.Settings}" Stretch="Uniform" Width="18" Height="18"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" Fill="{x:Null}" />
                    </Button>
                    <Grid DockPanel.Dock="Top" Margin="0,6,0,0">
                        <RadioButton x:Name="AllButton" Style="{StaticResource InboxButton}"
                                     Tag="{StaticResource Icon.Inbox}"
                                     GroupName="services"
                                     ToolTip="All messages (Ctrl+0)"
                                     Checked="All_Checked" />
                        <Border x:Name="AllBadge" Background="{DynamicResource Badge}" CornerRadius="7"
                                MinWidth="14" Height="14" Padding="3,0"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,2,2" IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <TextBlock x:Name="AllBadgeText" Foreground="White" FontSize="9"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Margin="0,-0.5,0,0" />
                        </Border>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,4,0,4" Focusable="False">
                        <ItemsControl x:Name="SidebarList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type shell:SidebarItem}">
                                    <RadioButton x:Name="SvcButton"
                                                 Style="{StaticResource ServiceButton}"
                                                 GroupName="services"
                                                 Tag="{Binding Icon}"
                                                 IsChecked="{Binding IsActive, Mode=OneWay}"
                                                 ToolTip="{Binding ToolTipText}"
                                                 Checked="Service_Checked">
                                        <RadioButton.ContextMenu>
                                            <ContextMenu Opened="Ctx_Opened">
                                                <MenuItem Header="Reload" Click="Ctx_Reload" Tag="{Binding Id}" />
                                                <MenuItem Click="Ctx_Hibernate" Tag="{Binding Id}">
                                                    <MenuItem.Style>
                                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                            <Setter Property="Header" Value="Hibernate" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDormant}" Value="True">
                                                                    <Setter Property="Header" Value="Resume" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </MenuItem.Style>
                                                </MenuItem>
                                                <Separator />
                                                <MenuItem Header="Change logo..." Click="Ctx_ChangeLogo" Tag="{Binding Id}" />
                                                <MenuItem Header="Reset logo" Click="Ctx_ResetLogo" Tag="{Binding Id}" />
                                                <Separator />
                                                <MenuItem Header="Open in browser" Click="Ctx_OpenBrowser" Tag="{Binding Id}" />
                                            </ContextMenu>
                                        </RadioButton.ContextMenu>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Content: webviews are injected into this grid from code -->
            <Grid Grid.Column="1" x:Name="ContentHost">

                <!-- Empty state (no services enabled) -->
                <Border x:Name="EmptyState" Background="{DynamicResource OverlayBg}" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340">
                        <TextBlock Text="No services enabled" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextAlignment="Center"
                                   Text="Enable WhatsApp, Facebook, Instagram, Telegram, Discord, Threads or any other service in Settings." />
                        <Button Content="Open Settings" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Center" Margin="0,16,0,0" Padding="16,7"
                                Click="Settings_Click" />
                    </StackPanel>
                </Border>

                <!-- State overlay (loading / failure) -->
                <Border x:Name="StateOverlay" Background="{DynamicResource OverlayBg}" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                        <Image x:Name="OverlayImage" Stretch="Uniform" Width="30" Height="30"
                               HorizontalAlignment="Center" Margin="0,0,0,12"
                               Visibility="Collapsed" IsHitTestVisible="False" />
                        <Path x:Name="OverlayIcon" Stretch="Uniform" Width="28" Height="28"
                              HorizontalAlignment="Center" Margin="0,0,0,12"
                              Stroke="{DynamicResource TextMuted}" StrokeThickness="1.5" Fill="{x:Null}" />
                        <TextBlock x:Name="OverlayTitle" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="OverlayMessage" Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button x:Name="OverlayPrimary" Content="Try again"
                                    Style="{StaticResource PrimaryButton}" Padding="14,6"
                                    Click="OverlayPrimary_Click" />
                            <Button x:Name="OverlaySecondary" Content="Open in browser"
                                    Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="10,0,0,0"
                                    Click="OverlaySecondary_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Unified inbox: WhatsApp-style split view. The left column is the
                     combined conversation list; the right pane hosts the selected
                     service's own WebView2 (reply happens in the service editor). -->
                <Border x:Name="ActivityPanel" Background="{DynamicResource BgSurface}" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ActivityListColumn" Width="340" MinWidth="280" MaxWidth="460" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ── Left: combined conversation list ── -->
                        <Border Grid.Column="0" Background="{DynamicResource BgSurface}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="0,0,0,1" Padding="18,16,14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="All messages" FontSize="17" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock x:Name="ActivitySubtitle" Style="{StaticResource MutedText}"
                                                       Margin="0,3,0,0"
                                                       Text="New messages from every connected service." />
                                        </StackPanel>
                                        <Button x:Name="ActivityMarkAllButton" Grid.Column="1"
                                                Content="Mark all read" Style="{StaticResource SecondaryButton}"
                                                Padding="10,4" VerticalAlignment="Center" FontSize="11"
                                                Click="ActivityMarkAll_Click" />
                                    </Grid>
                                </Border>

                                <Border x:Name="ActivitySleepBanner" Grid.Row="1"
                                        Background="{DynamicResource BgHover}"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                                        Padding="18,10" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="ActivitySleepText" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimary}" FontSize="11"
                                                   TextWrapping="Wrap" />
                                        <Button Content="Resume all" HorizontalAlignment="Left"
                                                Style="{StaticResource SecondaryButton}" Padding="10,3"
                                                FontSize="11" Margin="0,8,0,0"
                                                Click="ActivityResumeAll_Click" />
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="2">
                                    <ListBox x:Name="ActivityList" Background="Transparent" BorderThickness="0"
                                             Padding="6,4" SelectionChanged="ActivityList_SelectionChanged"
                                             Foreground="{DynamicResource TextPrimary}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingStackPanel.IsVirtualizing="True"
                                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource TextPrimary}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="rowBg" Background="Transparent" CornerRadius="8"
                                                                    Padding="10,8" Margin="6,1">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="rowBg" Property="Background"
                                                                            Value="{DynamicResource BgHover}" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="rowBg" Property="Background"
                                                                            Value="{DynamicResource BgActive}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type shell:ActivityRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Circular avatar: the service logo on a theme-aware disc. -->
                                                    <Border Width="40" Height="40" CornerRadius="20"
                                                            Background="{DynamicResource BgHover}"
                                                            VerticalAlignment="Top">
                                                        <Grid Margin="8">
                                                            <Image Source="{Binding Icon}" Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   IsHitTestVisible="False">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                            <Path Data="{Binding Glyph}"
                                                                  Fill="{DynamicResource TextPrimary}"
                                                                  Stretch="Uniform" IsHitTestVisible="False">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="8,0,10,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimary}"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Text="{Binding ServiceName}"
                                                                       Style="{StaticResource MutedText}" FontSize="10"
                                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding Body}"
                                                                   Style="{StaticResource MutedText}"
                                                                   FontSize="11.5" Margin="0,3,0,0"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding TimeText}"
                                                                   Style="{StaticResource MutedText}"
                                                                   FontSize="10" HorizontalAlignment="Right" />
                                                        <Border Background="{DynamicResource Badge}" CornerRadius="8"
                                                                MinWidth="16" Height="16" Padding="4,0"
                                                                HorizontalAlignment="Right" Margin="0,4,0,0"
                                                                Visibility="{Binding HasCount, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding CountText}" Foreground="White"
                                                                       FontSize="9" FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" Margin="0,-0.5,0,0" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel x:Name="ActivityEmpty" Background="{DynamicResource BgSurface}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                MaxWidth="300" Visibility="Collapsed">
                                        <Path Data="{StaticResource Icon.Inbox}"
                                              Fill="{DynamicResource TextPrimary}"
                                              Stretch="Uniform" Width="28" Height="28"
                                              HorizontalAlignment="Center" Opacity="0.6" />
                                        <TextBlock Text="No messages yet" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   HorizontalAlignment="Center" Margin="0,14,0,0" />
                                        <TextBlock x:Name="ActivityEmptyText" Style="{StaticResource MutedText}"
                                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Text="New-message notifications from your connected services appear here. Keep services awake to collect them." />
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="3" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="0,1,0,0" Padding="18,9">
                                    <TextBlock Style="{StaticResource MutedText}" FontSize="10.5" TextWrapping="Wrap"
                                               Text="Click a conversation to open the chat here and reply directly. Only new-message notifications are collected; chat history is not imported." />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ── Right: chat pane (the service WebView2 is positioned over this area) ── -->
                        <Grid Grid.Column="1" Background="{DynamicResource BgSurface}">
                            <StackPanel x:Name="ActivityChatPlaceholder"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        MaxWidth="360">
                                <Path Data="{StaticResource Icon.Inbox}" Fill="{DynamicResource TextPrimary}"
                                      Stretch="Uniform" Width="34" Height="34"
                                      HorizontalAlignment="Center" Opacity="0.45" />
                                <TextBlock Text="Select a conversation" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           HorizontalAlignment="Center" Margin="0,16,0,0" />
                                <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="The chat opens here in the service's own window, so you can read and reply without switching apps." />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
