<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BgSurface" Color="#F5F5F5" />
    <SolidColorBrush x:Key="BgHover" Color="#E9E9E9" />
    <SolidColorBrush x:Key="BgActive" Color="#E0E0E0" />
    <SolidColorBrush x:Key="BgCard" Color="#FFFFFF" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#1B1B1B" />
    <SolidColorBrush x:Key="TextMuted" Color="#6B6B6B" />
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF" />

    <!-- Accents -->
    <SolidColorBrush x:Key="Accent" Color="#0067C0" />
    <SolidColorBrush x:Key="Badge" Color="#D13438" />

    <!-- Lines -->
    <SolidColorBrush x:Key="ScrollThumb" Color="#C9C9C9" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#A8A8A8" />
    <SolidColorBrush x:Key="Border" Color="#E3E3E3" />

    <!-- Overlays drawn above web content -->
    <SolidColorBrush x:Key="OverlayBg" Color="#F5F5F5" />
    <SolidColorBrush x:Key="CaptionButtonHover" Color="#E5E5E5" />
    <SolidColorBrush x:Key="CaptionCloseHover" Color="#C42B1C" />

    <system:Double x:Key="CaptionButtonWidth" xmlns:system="clr-namespace:System;assembly=System.Runtime">46</system:Double>

</ResourceDictionary>
