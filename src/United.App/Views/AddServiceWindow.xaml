<Window x:Class="United.App.Views.AddServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a service"
        Icon="pack://application:,,,/Assets/united.ico"
        Width="500" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}"
        Background="{DynamicResource BgSurface}">

    <StackPanel Margin="24,18,24,20">
        <TextBlock Text="Add a service" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,16"
                   Text="Host any https:// website as its own service. It gets an isolated session, native notifications and a sidebar entry." />

        <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" MaxLength="64" Margin="0,0,0,12"
                 ToolTip="Shown in the sidebar, for example: Work chat" />

        <TextBlock Text="Address" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="UrlBox" Margin="0,0,0,12"
                 ToolTip="For example: https://example.com/messages" />

        <TextBlock Text="Logo (optional)" FontWeight="SemiBold" Margin="0,0,0,5" />
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="10"
                    Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" Margin="0,0,10,0">
                <Grid>
                    <Path x:Name="LogoGlyph" Data="{StaticResource Icon.Globe}" Stretch="Uniform"
                          Width="20" Height="20" StrokeThickness="1.4" Fill="{x:Null}"
                          Stroke="{DynamicResource TextMuted}" HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                    <Image x:Name="LogoPreview" Stretch="Uniform" Margin="5" Visibility="Collapsed" />
                </Grid>
            </Border>

            <Button Grid.Column="1" Content="Choose image..." Style="{StaticResource SecondaryButton}"
                    VerticalAlignment="Center" Click="ChooseLogo_Click" />
            <Button Grid.Column="2" Content="Clear" Style="{StaticResource SecondaryButton}"
                    VerticalAlignment="Center" Margin="6,0,0,0" Click="ClearLogo_Click" />
        </Grid>

        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,14"
                   Text="PNG recommended: square, 128-256 px, transparent background. JPG, ICO, BMP and GIF also work. The app saves a normalized PNG copy; you can change it later in Settings > Services." />

        <TextBlock Text="Notifications" FontWeight="SemiBold" Margin="0,0,0,4" />
        <ComboBox x:Name="ModeCombo" Width="270" HorizontalAlignment="Left" Margin="0,0,0,4" />

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Badge}" FontSize="11.5"
                   Margin="0,10,0,0" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True"
                    MinWidth="84" Margin="0,0,8,0" />
            <Button Content="Add service" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    MinWidth="104" Click="Add_Click" />
        </StackPanel>
    </StackPanel>
</Window>
